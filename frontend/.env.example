# ==============================================================================
# Interview Practice Coach - Frontend Configuration
# ==============================================================================

# Backend REST API Base URL
# In local dev (Vite dev server), default is http://localhost:8000
# In Docker / Nginx reverse proxy production setup, leave blank to use relative paths
VITE_API_BASE_URL=http://localhost:8000

# Backend WebSocket Endpoint Base URL
# In local dev, default is ws://localhost:8000
# In production reverse proxy, specify your wss:// or ws:// host
VITE_WS_URL=ws://localhost:8000
