# ==============================================================================
# Interview Practice Coach - Backend Configuration
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# SQLite Persistence Path
# Relative paths resolve relative to backend directory
# Use :memory: for automated ephemeral testing
PRACTICE_COACH_DB_PATH=practice_coach.db

# Faster-Whisper Speech Recognition Model Configuration
# Options for WHISPER_MODEL_SIZE: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=tiny

# Options for WHISPER_DEVICE: cpu, cuda
WHISPER_DEVICE=cpu

# Options for WHISPER_COMPUTE_TYPE: int8, float16, float32, int8_float16
WHISPER_COMPUTE_TYPE=int8

# Hugging Face / Model Weights Cache Directory
# HF_HOME=./models_cache
